<?xml version="1.0" encoding="UTF-8"?>
<wave_config>
   <wave_state>
   </wave_state>
   <db_ref_list>
      <db_ref path="main_behav.wdb" id="1">
         <top_modules>
            <top_module name="main" />
         </top_modules>
      </db_ref>
   </db_ref_list>
   <zoom_setting>
      <ZoomStartTime time="0.000000 us"></ZoomStartTime>
      <ZoomEndTime time="11.000001 us"></ZoomEndTime>
      <Cursor1Time time="11.000000 us"></Cursor1Time>
   </zoom_setting>
   <column_width_setting>
      <NameColumnWidth column_width="174"></NameColumnWidth>
      <ValueColumnWidth column_width="84"></ValueColumnWidth>
   </column_width_setting>
   <WVObjectSize size="3" />
   <wvobject type="logic" fp_name="/main/CLK">
      <obj_property name="ElementShortName">CLK</obj_property>
      <obj_property name="ObjectShortName">CLK</obj_property>
   </wvobject>
   <wvobject type="array" fp_name="/main/LED">
      <obj_property name="ElementShortName">LED[3:0]</obj_property>
      <obj_property name="ObjectShortName">LED[3:0]</obj_property>
   </wvobject>
   <wvobject type="logic" fp_name="/main/state">
      <obj_property name="ElementShortName">state</obj_property>
      <obj_property name="ObjectShortName">state</obj_property>
   </wvobject>
</wave_config>
